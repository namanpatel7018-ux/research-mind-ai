# ==============================================================================
# ResearchMind AI - Production Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this template to .env in the project root: cp .env.example .env
# 2. Populate REQUIRED variables before deploying to production.
# 3. Restrict permissions: chmod 600 .env
# 4. NEVER commit your actual .env file to version control.
# ==============================================================================

# --- Environment Mode ---
# Options: production | development | testing
# Setting ENV=production enforces strict security validation:
#   - SECRET_KEY must be set to a secure, high-entropy key (min 32 characters)
#   - CORS origins are strictly restricted (no default localhost)
#   - Interactive API documentation (/docs, /redoc) is disabled by default
ENV=production

# --- Authentication & JWT Security (REQUIRED) ---
# Generate a cryptographically secure 64-char key using:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secure_random_64_char_hex_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI Providers (AT LEAST ONE REQUIRED) ---
# Google Gemini (Literature Review, Document Comparison, PPT Generation, Comprehensive Reports)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Groq (Ultra-fast interactive chat, quick QA, and interactive quiz generation)
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# AI Router Thresholds (Optional tuning)
AI_CONTEXT_THRESHOLD=15000
AI_COMPLEXITY_THRESHOLD=standard

# --- Server & Network Binding ---
HOST=0.0.0.0
PORT=8000
FRONTEND_PORT=80

# --- Domain & CORS Configuration (REQUIRED FOR PRODUCTION) ---
# In production, set to your EC2 domain or public IP: e.g., https://researchmind.yourdomain.com
FRONTEND_URL=https://your-domain.com
BACKEND_URL=https://your-domain.com
# Comma-separated list of allowed origins. Do NOT use wildcards in production.
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# --- API Documentation & Security ---
# Disable /docs and /openapi.json in production (true | false)
ENABLE_DOCS=false

# --- Rate Limiting (Requests per minute) ---
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Google OAuth (OPTIONAL - for Google Single Sign-On) ---
# Configure at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://your-domain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- SMTP / Email OTP Verification (OPTIONAL - enables live email verification) ---
# For Gmail: enable 2FA -> generate 16-character App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=ResearchMind AI <noreply@yourdomain.com>

# --- Storage & Data Persistence (Configured by Docker Compose) ---
DATA_DIR=/app/data
UPLOAD_DIR=/app/uploads

# --- Remote Vector Storage (OPTIONAL - embedded local Qdrant is used by default) ---
# QDRANT_URL=https://your-qdrant-cluster.cloud.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_api_key_here

# --- Frontend Build Configuration (Injected at Docker build time) ---
VITE_API_URL=/api
