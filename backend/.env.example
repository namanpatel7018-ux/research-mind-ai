# ==============================================================================
# ResearchMind AI - Backend Environment Template (backend/.env.example)
# ==============================================================================

# --- Environment Mode ---
# Options: production | development | testing
ENV=production

# --- Authentication & JWT Security (REQUIRED) ---
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secure_random_64_char_hex_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI Providers (AT LEAST ONE REQUIRED) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

AI_CONTEXT_THRESHOLD=15000
AI_COMPLEXITY_THRESHOLD=standard

# --- Server & CORS Binding ---
HOST=0.0.0.0
PORT=8000
BACKEND_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# --- Security & Docs Control ---
ENABLE_DOCS=false
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Google OAuth (Optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- SMTP / Email OTP (Optional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=ResearchMind AI <noreply@yourdomain.com>

# --- Storage Directories ---
DATA_DIR=/app/data
UPLOAD_DIR=/app/uploads

# --- Remote Vector Storage (Optional) ---
# QDRANT_URL=
# QDRANT_API_KEY=
